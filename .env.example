# =============================================================================
# HOMA Frontend Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control

# API Configuration
# -----------------
# Base URL for backend API (Django runs on port 8000)
# Note: /api prefix is added automatically by apiClient.ts
VITE_API_BASE_URL=http://localhost:8000

# Media Configuration
# -------------------
# Caching CDN host serving PUBLIC product/shop images directly from MinIO.
# Dev: http://localhost:9000   Prod: https://cdn.myhoma.ir
VITE_PUBLIC_MEDIA_BASE_URL=http://localhost:9000
# MinIO bucket name (used for path-style public URLs built from a bare path).
VITE_PUBLIC_MEDIA_BUCKET=product-visualizer
# Direct-to-MinIO host serving PRIVATE images via presigned URLs. Only used to
# widen the CSP connect-src for image download/share in prod.
# Dev: leave blank   Prod: https://s3.myhoma.ir
VITE_PRIVATE_MEDIA_BASE_URL=

# Request timeout in milliseconds (default: 30 seconds)
VITE_API_TIMEOUT=30000

# Upload timeout in milliseconds (default: 3 minutes for large files + AI processing)
VITE_UPLOAD_TIMEOUT=180000

# Umami Analytics (self-hosted)
# -----------------------------
# Full URL of the Umami tracking script and the website ID for this app.
VITE_UMAMI_SRC=https://analytics.myhoma.ir/script.js
VITE_UMAMI_WEBSITE_ID=bbf04a62-584f-4b2e-97b3-6a177ddf093b
# Uncomment to enable Umami in dev mode (disabled by default)
# VITE_ENABLE_UMAMI_IN_DEV=true

# Auth Configuration (optional - defaults are fine for most cases)
# ----------------------------------------------------------------
# Auth mode: 'otp' (SMS-based login) or 'password' (password-based login)
# Default: 'password' if not set
VITE_AUTH_MODE=otp

# Access token expiry in seconds (should match backend: 30 minutes)
# VITE_ACCESS_TOKEN_EXPIRY=1800

# Refresh token expiry in seconds (should match backend: 7 days)
# VITE_REFRESH_TOKEN_EXPIRY=604800
