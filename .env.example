# =============================================================================
# HOMA Frontend Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control

# API Configuration
# -----------------
# Base URL for backend API (Django runs on port 8000)
VITE_API_BASE_URL=http://localhost:8000/api

# Request timeout in milliseconds (default: 30 seconds)
VITE_API_TIMEOUT=30000

# Upload timeout in milliseconds (default: 3 minutes for large files + AI processing)
VITE_UPLOAD_TIMEOUT=180000

# Auth Configuration (optional - defaults are fine for most cases)
# ----------------------------------------------------------------
# Access token expiry in seconds (should match backend: 30 minutes)
# VITE_ACCESS_TOKEN_EXPIRY=1800

# Refresh token expiry in seconds (should match backend: 7 days)
# VITE_REFRESH_TOKEN_EXPIRY=604800
